# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; this template is not, so never
# put a real key in this file.
#
# Only the Gemini key is required. Everything else has a working default —
# set a variable only when you want to change it.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for anything that uses the LLM ──────────────────────────────────
# Without a key: the Assistant chat, news sentiment and the AI Assistant tab
# report that they are unconfigured. Charts, screeners and backtests still work.
#
# GOOGLE_API_KEY is the name langchain-google-genai reads by default.
# GEMINI_API_KEY is accepted as an alternative — set whichever you already have.
GOOGLE_API_KEY=<your-gemini-api-key>
# GEMINI_API_KEY=<alternative name for the same key>

# The exact model id string. Change this one line if the API rejects the default
# as unknown — nothing else in the app hard-codes a model name.
GEMINI_MODEL_NAME=gemini-3.5-flash

# ── Risk and sizing (defaults shown) ─────────────────────────────────────────
# ACCOUNT_EQUITY is the book the vol-targeted sizer sizes against, and the
# starting stake for every backtest.
ACCOUNT_EQUITY=100000.0
# Annualised volatility budget per position. Size scales inversely with each
# name's own volatility, so every holding contributes comparable risk.
TARGET_VOL=0.15
# Hard cap on one position as a fraction of equity.
MAX_POSITION_PCT=0.25

# ── Market regime gate (defaults shown) ──────────────────────────────────────
# Blocks NEW entries while the benchmark trades below its 200 SMA. Exits are
# never gated — a risk-off reading must not trap an open position.
USE_REGIME_GATE=true
REGIME_BENCHMARK=^GSPC

# ── News sentiment (default shown) ───────────────────────────────────────────
# How far back the Assistant tab looks for headlines. Nothing inside the window
# is reported as "no recent news" rather than scored as neutral. Widen it if the
# names you follow are quiet.
NEWS_WINDOW_DAYS=2

# ── Interactive Brokers TWS / Gateway (defaults shown) ───────────────────────
# Read by notebooks/ib_tws_connect.ipynb only. TWS or IB Gateway must already be
# running and logged in, with "Enable ActiveX and Socket Clients" ticked.
# Port: 7497 TWS paper | 7496 TWS live | 4002 Gateway paper | 4001 Gateway live.
IB_HOST=127.0.0.1
IB_PORT=7497
# Every concurrent API session needs its own id. Reusing one another script holds
# is the usual cause of a connect that just times out. 0 is reserved by TWS.
IB_CLIENT_ID=17
# 1 live | 2 frozen | 3 delayed | 4 delayed-frozen. Delayed is the default because
# it works without a market-data subscription.
IB_MARKET_DATA_TYPE=3

# ── Tab visibility ───────────────────────────────────────────────────────────
# Most tabs default to ON. Two default to OFF and must be switched on here if
# you want them: the Assistant tab, and the older standalone Sentiment tab
# (whose per-symbol news now also lives inside the Assistant tab).
SHOW_TAB_BREAKOUT=true
SHOW_TAB_SCREENER=true
SHOW_TAB_SWING=true
SHOW_TAB_CHATBOT=true
SHOW_TAB_ASSISTANT=false
SHOW_TAB_SENTIMENT=false

# ── Local state file locations (defaults shown) ──────────────────────────────
# watchlist.json is untracked by default. Commit it if you want the watchlist to
# follow you between machines; .chat_history stays local either way.
WATCHLIST_FILE=./watchlist.json
CHAT_HISTORY_DIR=./.chat_history

# ── Obsolete — delete these from your .env if present ────────────────────────
# AZURE_INFERENCE_ENDPOINT    the app moved off Azure AI Foundry to Gemini
# AZURE_INFERENCE_CREDENTIAL  same
# DEEPSEEK_MODEL_NAME         replaced by GEMINI_MODEL_NAME
# POS_SIZE_USD        replaced by TARGET_VOL / MAX_POSITION_PCT sizing
# MAX_POS             replaced by MAX_POSITION_PCT
# INITIAL_ETH_PRICE   never read
# SHOW_TAB_PORTFOLIO  no portfolio tab exists
