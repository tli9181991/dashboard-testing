# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; this template is not, so never
# put a real key in this file.
#
# Only the Azure block is required. Everything else has a working default —
# set a variable only when you want to change it.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for anything that uses the LLM ──────────────────────────────────
# Without these: the Assistant chat, news sentiment and the AI Assistant tab
# report that they are unconfigured. Charts, screeners and backtests still work.
AZURE_INFERENCE_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
AZURE_INFERENCE_CREDENTIAL=<your-azure-ai-foundry-key>
DEEPSEEK_MODEL_NAME=DeepSeek-V4-Flash

# ── Risk and sizing (defaults shown) ─────────────────────────────────────────
# ACCOUNT_EQUITY is the book the vol-targeted sizer sizes against, and the
# starting stake for every backtest.
ACCOUNT_EQUITY=100000.0
# Annualised volatility budget per position. Size scales inversely with each
# name's own volatility, so every holding contributes comparable risk.
TARGET_VOL=0.15
# Hard cap on one position as a fraction of equity.
MAX_POSITION_PCT=0.25

# ── Market regime gate (defaults shown) ──────────────────────────────────────
# Blocks NEW entries while the benchmark trades below its 200 SMA. Exits are
# never gated — a risk-off reading must not trap an open position.
USE_REGIME_GATE=true
REGIME_BENCHMARK=^GSPC

# ── News sentiment (default shown) ───────────────────────────────────────────
# How far back the Assistant tab looks for headlines. Nothing inside the window
# is reported as "no recent news" rather than scored as neutral. Widen it if the
# names you follow are quiet.
NEWS_WINDOW_DAYS=2

# ── Tab visibility (all default to true except SHOW_TAB_PORTFOLIO) ───────────
SHOW_TAB_BREAKOUT=true
SHOW_TAB_SCREENER=true
SHOW_TAB_SWING=true
SHOW_TAB_SENTIMENT=true
SHOW_TAB_ASSISTANT=true
SHOW_TAB_CHATBOT=true

# ── Local state file locations (defaults shown) ──────────────────────────────
# watchlist.json is untracked by default. Commit it if you want the watchlist to
# follow you between machines; .chat_history stays local either way.
WATCHLIST_FILE=./watchlist.json
CHAT_HISTORY_DIR=./.chat_history

# ── Obsolete — delete these from your .env if present ────────────────────────
# GOOGLE_API_KEY      superseded by the Azure block when the app moved to DeepSeek
# POS_SIZE_USD        replaced by TARGET_VOL / MAX_POSITION_PCT sizing
# MAX_POS             replaced by MAX_POSITION_PCT
# INITIAL_ETH_PRICE   never read
# SHOW_TAB_PORTFOLIO  no portfolio tab exists
